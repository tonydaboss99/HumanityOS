style.css
body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #222;
    margin: 0;
    padding: 20px;
}

nav {
    background: #0b3d91;
    padding: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-right: 15px;
    font-weight: bold;
}

h1 {
    color: #0b3d91;
}

button {
    background: #0b3d91;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 6px;
    cursor: pointer;
}

button:hover {
    opacity: 0.9;
}